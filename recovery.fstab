# TWRP fstab - golden (GT-I8190)
# <mount point>   <fs>    <device>                      [<device2>]   <flags>
/boot             emmc    /dev/block/mmcblk0p20
/recovery         emmc    /dev/block/mmcblk0p21
/system           ext4    /dev/block/mmcblk0p22
/cache            ext4    /dev/block/mmcblk0p23
/data             ext4    /dev/block/mmcblk0p25         flags=encryptable=footer;length=-16384
/efs              ext4    /dev/block/mmcblk0p11         flags=display="EFS";backup=1
/modemfs          ext4    /dev/block/mmcblk0p12         flags=display="Modem FS";backup=1

# External SD
/external_sd      auto    /dev/block/mmcblk1p1          /dev/block/mmcblk1    flags=display="MicroSD";storage;wipeingui;removable

# OTG
/usb-otg          auto    /dev/block/sda1               /dev/block/sda        flags=display="USB OTG";storage;wipeingui;removable
